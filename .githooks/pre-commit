#!/bin/sh
# .githooks/pre-commit
# Solvagio no-AI-attribution rule enforcement.
#
# Refuses commits that introduce forbidden AI-authorship patterns in their
# staged diff. See root Solvagio/CLAUDE.md "No AI attribution anywhere in
# the codebase" rule for the full policy.
#
# Patterns flagged are strictly attribution shapes (co-authorship trailers,
# "generated by AI", etc.) — bare vendor names like "openai" / "anthropic"
# / "ollama" are NOT flagged because they appear legitimately in feature
# code (e.g. AI_PROVIDER env paths).
#
# Activated by setting: git config core.hooksPath .githooks  (once per clone)
# Bypass once (when you're sure): git commit --no-verify

set -e

FORBIDDEN='co-authored-by:[[:space:]]*claude|co-authored-by:[[:space:]]*copilot|co-authored-by:[[:space:]]*chatgpt|generated by ai|generated by claude|generated by copilot|ai-generated|ai-assisted|ai-driven|llm-generated|claude wrote|chatgpt wrote|copilot wrote'

# Grep the ADDED lines of the staged diff (lines starting with "+", excluding "+++" diff headers).
# --diff-filter=AM restricts to added or modified files; renames/deletes never introduce text.
# Pathspec exclusion: this hook carries the forbidden patterns as the literal strings it searches
# for, so it must be excluded or it flags itself.
#
# CORRECTION, 2026-09-10. This comment used to say that .github/workflows/attribution-check.yml
# "has never existed in any Solvagio repo" and that "only Website has GitHub Actions at all".
# Both were false, and this repo was one of the counter-examples: Castellan carried that exact
# workflow plus automerge.yml until today. The workflow was well-formed - a plain git grep, no
# toolchain, no token - but it triggered on `pull_request` only, and the fleet commits straight
# to main and opens no PRs, so it had never once run. It is deleted for that reason, not for
# being broken, and the whole-tree scan below is what replaces it.
#
# The star and the trailing /* are both load-bearing. Pathspecs are REPO-ROOT-relative, and a
# wildcard one must match the WHOLE path - ':!*.githooks/' matches the directory and nothing
# inside it. Measured, git 2.55.0. This spelling is identical in every Solvagio repo.
HITS=$(git diff --cached --diff-filter=AM -U0 -- \
    ':!*.githooks/*' \
  | grep -i -E "^\+[^+].*($FORBIDDEN)" || true)

if [ -n "$HITS" ]; then
  echo "ERROR: commit blocked by Solvagio no-AI-attribution rule."
  echo ""
  echo "The following staged lines contain forbidden AI-authorship patterns:"
  echo ""
  echo "$HITS"
  echo ""
  echo "See Solvagio/CLAUDE.md 'No AI attribution anywhere in the codebase'"
  echo "for the full rule. Edit the staged content to neutralize the wording,"
  echo "or bypass once with: git commit --no-verify"
  echo ""
  exit 1
fi

# WHOLE-TREE SCAN. Everything above reads the staged DIFF, so it only ever sees lines this
# commit ADDS. A line already sitting in the tree - committed before this hook existed, or
# waved through with --no-verify - is invisible to it for ever, which is the whole reason the
# consoles run scripts/check-attribution.mjs from their gate. This repo has no package.json
# anywhere and no gate to hang one from, so the same scan is done here, in the tool the hook
# already is. Introducing a node toolchain to a repo that has none, purely to run one grep,
# would be a bigger change than the check is worth.
#
# --untracked makes git grep cover tracked files PLUS untracked-and-not-ignored ones, which is
# the same set as `git ls-files -co --exclude-standard` that the node scanner walks. -I skips
# binaries. The flags MUST come before the pattern: git parses a bare argument after the
# pattern as a revision, so `git grep -i -E "$PAT" --untracked` dies with
# "unable to resolve revision: --untracked" - measured, git 2.55.0, while writing this.
#
# git grep exits 1 for "no matches" and 0 for "matches", so the usual `|| true` would also
# swallow a 128 and report a scan that could not run as a clean tree. The status is kept.
set +e
TREE_HITS=$(git grep --untracked -I -i -n -E "$FORBIDDEN" -- ':!*.githooks/*')
tree_rc=$?
set -e

if [ "$tree_rc" -gt 1 ]; then
  echo "ERROR: the whole-tree attribution scan could not run (git grep exit $tree_rc)." >&2
  echo "A scan that did not happen is not a scan that passed. Commit refused." >&2
  exit 1
fi

if [ -n "$TREE_HITS" ]; then
  echo "ERROR: commit blocked by Solvagio no-AI-attribution rule."
  echo ""
  echo "These lines are ALREADY IN THE TREE (this commit did not add them):"
  echo ""
  echo "$TREE_HITS"
  echo ""
  echo "See Solvagio/CLAUDE.md 'No AI attribution anywhere in the codebase'."
  echo "Remove the wording, or bypass once with: git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
