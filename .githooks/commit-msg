#!/bin/sh
# .githooks/commit-msg
# Message SHAPE: the blank line between subject and body, and a sane subject length.
#
# Refuses two things:
#
#   1. A second line that is not blank. Git reads everything up to the first
#      BLANK line as the SUBJECT, so a message whose body starts on line 2 is
#      swallowed whole into the subject: `git log --oneline` prints the lot and
#      `%s` returns it joined with spaces.
#
#   2. A subject longer than 120 bytes.
#
#   3. AI-authorship wording ANYWHERE in the message - subject or body.
#      ORG_RULES section 1 names commit messages explicitly, and until 2026-09-11 no hook
#      had ever read one. pre-commit scans the staged DIFF and the whole TREE; this hook
#      checked the subject's SHAPE and LENGTH. The message BODY was the one surface the
#      rule names and no guard looked at, and it held 166 lines across 10 repos by the
#      time anyone counted - the largest breach in the fleet, in the only place that
#      cannot be cleaned without rewriting pushed history. Those 166 are a recorded
#      historical breach; this stops the number moving.
#
# Why 120 and not the conventional 72: measured 2026-09-09 across 1788 fleet
# subjects - median 68, p90 97, p95 110, p99 153. A 72 limit would have refused
# 40% of them, and a hook that red-lines two commits in five is a hook that gets
# --no-verify'd, which ORG_RULES section 6 already warns is worse than no hook.
# 120 refuses 3.3% and nothing written routinely. The blank-line rule scored 8
# hits across 793 multi-line commits and all 8 were the defect it exists to catch.
#
# What it is for: on 2026-09-09 eight commits landed across the fleet carrying
# subjects of 378-753 characters, because a message assembled in PowerShell
# contributed one newline where two were needed. `git log -1 --format='|%s'`
# displayed the defect on every one of them and it was read past. A check a
# human has to notice is the weakest kind of check.
#
# Activated by: git config core.hooksPath .githooks   (once per clone)
# Bypass once (when you are sure): git commit --no-verify

set -e

MAX_SUBJECT=120

# Git strips comment lines and leading blanks before storing the message, so
# measure what git will STORE, not what is sitting in the file.
STORED=$(sed -e '/^#/d' "$1" | sed -e '/./,$!d')
SUBJECT=$(printf '%s\n' "$STORED" | head -n 1)
SECOND=$(printf '%s\n' "$STORED" | sed -n '2p')

# THE ATTRIBUTION CHECK RUNS FIRST, BEFORE the autosquash/merge exemptions below.
# Those exemptions are right for SHAPE - git writes those subjects itself and their form is
# not the author's to fix - but they are not right for attribution: a merge or a revert can
# carry the trailer of the commit it names, and an exemption that skips every check is how
# the one rule with no exceptions acquires one.
#
# Same pattern as .githooks/pre-commit, deliberately duplicated rather than sourced: a hook
# that reads a sibling file stops working the moment the sibling is missing, and these run
# in clones where only core.hooksPath has been set.
FORBIDDEN='co-authored-by:[[:space:]]*claude|co-authored-by:[[:space:]]*copilot|co-authored-by:[[:space:]]*chatgpt|generated by ai|generated by claude|generated by copilot|ai-generated|ai-assisted|ai-driven|llm-generated|claude wrote|chatgpt wrote|copilot wrote|generated with \[claude|claude-session:'

ATTR_HITS=$(printf '%s\n' "$STORED" | grep -i -n -E "$FORBIDDEN" || true)
if [ -n "$ATTR_HITS" ]; then
  echo "commit-msg: refused by the Solvagio no-AI-attribution rule." >&2
  echo "            The rule covers commit messages, not just code:" >&2
  echo "" >&2
  printf '%s\n' "$ATTR_HITS" | sed 's/^/              /' >&2
  echo "" >&2
  echo "            Remove those lines from the message. There is no legitimate --no-verify" >&2
  echo "            here: unlike a subject that is too long, this is not a formatting" >&2
  echo "            opinion, and the message is the one place a breach cannot be edited" >&2
  echo "            afterwards without rewriting history." >&2
  exit 1
fi

# Subjects git writes itself, plus the autosquash prefixes.
case "$SUBJECT" in
'Merge '* | 'Revert '* | 'fixup! '* | 'squash! '* | 'amend! '*) exit 0 ;;
esac

fail=0

if [ -n "$SECOND" ]; then
  echo "commit-msg: line 2 is not blank, so this whole message becomes the SUBJECT." >&2
  echo "            Put an empty line between the subject and the body." >&2
  echo "            line 2: $SECOND" >&2
  fail=1
fi

n=$(printf '%s' "$SUBJECT" | wc -c | tr -d ' ')
if [ "$n" -gt "$MAX_SUBJECT" ]; then
  echo "commit-msg: subject is $n bytes, over the $MAX_SUBJECT-byte limit." >&2
  echo "            $SUBJECT" >&2
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "commit-msg: refused. Fix the message, or use 'git commit --no-verify' if you are sure." >&2
  exit 1
fi
exit 0
